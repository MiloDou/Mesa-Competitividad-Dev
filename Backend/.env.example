DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE=sqlite for local development without Docker.
DB_ENGINE=sqlite
DB_NAME=mesa_competitividad
DB_USER=mesa_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_SSLROOTCERT=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8081
CONTACT_NOTIFICATION_EMAIL=
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Optional Expo Push API access token. Push deliveries remain queued if unset.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ENABLED=false

# Upload limits and document policy.
MAX_UPLOAD_SIZE_MB=20
# Optional PostgreSQL backup tools if PATH does not select a compatible pair.
PG_DUMP_PATH=
PG_RESTORE_PATH=
