DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Leave DB_ENGINE=sqlite for local development without Docker.
DB_ENGINE=sqlite
DB_NAME=mesa_competitividad
DB_USER=mesa_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_SSLROOTCERT=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8081
CONTACT_NOTIFICATION_EMAIL=mesadequetzaltenango@gmail.com
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
BREVO_API_KEY=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Password recovery uses the Brevo API when BREVO_API_KEY is set.
# Configure a verified sender in DEFAULT_FROM_EMAIL.
# SMTP remains available as a fallback when BREVO_API_KEY is empty.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=brevo-smtp-login
# EMAIL_HOST_PASSWORD=brevo-smtp-key
